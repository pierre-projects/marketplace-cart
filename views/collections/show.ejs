<main class="container" id="main">
  <%- include('../partials/flash-alert') %>

  <!-- Page Header -->
  <div class="page-head">
    <div class="page-head__main">
      <a href="/collections" class="back-link">&larr; Collections</a>

      <%
        // Owners edit the title in place. Everyone else gets a plain heading —
        // the route is owner-scoped, so the affordance must be too.
      %>
      <% if (isOwner) { %>
        <h1 class="collection-title"
            id="collectionTitle"
            data-category-id="<%= category._id %>"
            data-name="<%= category.name %>"
            tabindex="0"
            role="button"
            aria-label="Rename this collection">
          <span class="collection-title__text"><%= category.name %></span>
          <svg class="collection-title__pencil" width="15" height="15" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M13.6 2.6a1.9 1.9 0 0 1 2.7 2.7l-8.5 8.5-3.6.9.9-3.6 8.5-8.5Z"
                  fill="none" stroke="currentColor" stroke-width="1.6"
                  stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </h1>
      <% } else { %>
        <h1><%= category.name %></h1>
      <% } %>

      <%
        // Badges inline with the title, rather than the stacked full-width
        // notices that used to push the content down the page.
      %>
      <div class="collection-badges">
        <% if (!isOwner && user) { %>
          <span class="badge badge--neutral">Shared with you<% if (canEdit) { %> · can edit<% } %></span>
        <% } %>
        <% if (category.isPublic) { %>
          <span class="badge badge--neutral">Public</span>
        <% } %>
      </div>
    </div>

    <% if (canEdit || isOwner) { %>
      <div class="page-head__actions">
        <% if (canEdit) { %>
          <button id="openAddModal" type="button" class="btn btn--primary">Save an item</button>
        <% } %>
        <% if (isOwner) { %>
          <button type="button" id="openSettingsModal" class="btn btn--secondary">Settings</button>
        <% } %>
      </div>
    <% } %>
  </div>

  <% if (stats.totalItems > 0) { %>
    <%- include('../partials/stats-panel', {
      stats, breakdown: locals.breakdown, panelLabel: 'Collection total'
    }) %>
  <% } %>

  <% if (canEdit) { %>
    <%- include('../partials/add-listing-modal', {
      categories,
      returnTo: `/collections/${category._id}`,
      formAction: `/collections/${category._id}/add-item`,
      lockedCategoryId: String(category._id),
      lockCategorySelection: true
    }) %>
  <% } %>

  <!-- Items -->
  <% if (category.items.length === 0) { %>
    <div class="empty-state">
      <p>Nothing in this collection yet.</p>
      <% if (canEdit) { %>
        <p class="muted">Add one using the Add listing button above.</p>
      <% } %>
    </div>
  <% } else { %>
    <%- include('../partials/item-list', {
      items: locals.items || category.items,
      categories,
      allowEdit: canEdit,
      allowDelete: canEdit,
      showCategories: false,
      categoryId: category._id,
      user: user,
      isOwner: isOwner,
      showAddedBy: true
    }) %>
  <% } %>

  <%
    // The per-marketplace breakdown that used to live here now sits in the
    // stats panel above the grid, where it is read before scrolling past every
    // item — and it shows for a single marketplace too.
  %>
</main>

<!-- Settings Modal (owner only) -->
<% if (isOwner) { %>
  <dialog id="settingsModal" class="modal collection-settings-modal" aria-labelledby="settingsModalTitle">
    <div class="modal-content">
      <div class="modal-header">
        <h2 id="settingsModalTitle">Collection settings</h2>
        <button type="button" class="modal-close" aria-label="Close collection settings">&times;</button>
      </div>
      <div class="modal-body">

        <!-- Rename -->
        <section class="collection-settings-section" aria-labelledby="settingsNameHeading">
          <div class="collection-settings-section__head">
            <h3 id="settingsNameHeading">Name</h3>
          </div>
          <form action="/collections/<%= category._id %>/edit" method="POST" class="collection-settings-form">
            <%- csrfField %>
            <div class="collection-settings-input-row">
              <label class="sr-only" for="settingsRename">Collection name</label>
              <input type="text" id="settingsRename" name="name" value="<%= category.name %>"
                     required maxlength="60">
              <input type="hidden" name="returnTo" value="/collections/<%= category._id %>">
              <button type="submit" class="btn btn--primary">Save</button>
            </div>
          </form>
        </section>

        <section class="collection-settings-section" aria-labelledby="settingsVisibilityHeading">
          <div class="collection-settings-section__head">
            <h3 id="settingsVisibilityHeading">Visibility</h3>
          </div>
          <form action="/collections/<%= category._id %>/visibility" method="POST" class="collection-settings-visibility-form">
            <%- csrfField %>
            <label class="collection-settings-toggle">
              <input type="checkbox" name="isPublic" value="true"
                     aria-describedby="settingsVisibilityHint"
                     <%= category.isPublic ? 'checked' : '' %>>
              <span class="collection-settings-toggle__control" aria-hidden="true"></span>
              <span class="collection-settings-toggle__copy">
                <span class="collection-settings-toggle__title">Public collection</span>
                <span id="settingsVisibilityHint" class="collection-settings-toggle__hint">Anyone with the link can view this collection.</span>
              </span>
            </label>
          </form>
        </section>

        <!-- Share -->
        <section class="collection-settings-section" aria-labelledby="settingsShareHeading">
          <div class="collection-settings-section__head">
            <h3 id="settingsShareHeading">Share</h3>
          </div>
          <form action="/collections/<%= category._id %>/share" method="POST" class="share-form">
            <%- csrfField %>
            <label class="sr-only" for="settingsShareEmail">User email</label>
            <input type="email" id="settingsShareEmail" name="email" placeholder="User email" required>
            <label class="sr-only" for="settingsShareAccess">Access level</label>
            <select id="settingsShareAccess" name="access">
              <option value="viewer">Viewer</option>
              <option value="editor">Editor</option>
            </select>
            <button type="submit" class="btn btn--primary">Share</button>
          </form>
        </section>

        <!-- Shared Users -->
        <% if (category.usersAdded && category.usersAdded.length > 0) { %>
          <section class="collection-settings-section" aria-labelledby="settingsSharedHeading">
            <div class="collection-settings-section__head">
              <h3 id="settingsSharedHeading">Shared with</h3>
            </div>
            <ul class="shared-users-list">
              <% category.usersAdded.forEach(entry => { %>
                <li class="shared-user-row">
                  <span class="shared-user-name"><%= entry.user.username %></span>
                  <form action="/collections/<%= category._id %>/update-role" method="POST" class="role-form">
                    <%- csrfField %>
                    <input type="hidden" name="userId" value="<%= entry.user._id %>">
                    <select name="newRole" data-autosubmit>
                      <option value="viewer" <%= entry.role === 'viewer' ? 'selected' : '' %>>Viewer</option>
                      <option value="editor" <%= entry.role === 'editor' ? 'selected' : '' %>>Editor</option>
                    </select>
                  </form>
                  <form action="/collections/<%= category._id %>/remove-user" method="POST">
                    <%- csrfField %>
                    <input type="hidden" name="userId" value="<%= entry.user._id %>">
                    <button type="submit" class="remove-user-btn"
                            aria-label="Remove access for <%= entry.user.username %>"
                            data-confirm="Remove access for this user?">&times;</button>
                  </form>
                </li>
              <% }) %>
            </ul>
          </section>
        <% } %>

        <section class="collection-settings-section collection-settings-section--danger danger-zone" aria-labelledby="settingsDangerHeading">
          <div class="collection-settings-section__head">
            <h3 id="settingsDangerHeading" class="danger-label">Danger zone</h3>
          </div>
          <div class="danger-row">
            <div>
              <p class="danger-row__title">Delete this collection</p>
              <p class="danger-warning">Items stay in Saved items.</p>
            </div>
            <form action="/collections/<%= category._id %>?_method=DELETE" method="POST">
              <%- csrfField %>
              <button type="submit" class="btn btn--danger"
                      data-confirm="Delete this collection? The items stay in Saved items.">
                Delete
              </button>
            </form>
          </div>
        </section>

      </div>
    </div>
  </dialog>
<% } %>

<script type="module" src="/js/pages/collection.js"></script>
