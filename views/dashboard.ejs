<main class="container" id="main">
  <%- include('partials/flash-alert') %>

  <%
    const defaultCollection = categories.find(c => c.isDefault);
    // Supplied by the route, already newest-first. Deriving it from
    // defaultCollection.items here would reintroduce push order.
    const savedItems = locals.savedItems || (defaultCollection ? defaultCollection.items : []);
    const userCollections = categories.filter(c => !c.isDefault);
  %>

  <div class="page-head">
    <h1>Your cart</h1>
    <button id="openAddModal" type="button" class="btn btn--primary">Save an item</button>
  </div>

  <%- include('partials/add-listing-modal', { categories, returnTo: '/dashboard', defaultCategoryId: null }) %>

  <%
    // One confident number, now with the per-marketplace split beneath it —
    // the same panel the collection pages use, so the two never diverge.
  %>
  <%
    // locals.breakdown, not breakdown: a bare identifier that is not supplied
    // throws a ReferenceError when the include's data object is built — before
    // the partial's own guard can run.
  %>
  <%- include('partials/stats-panel', {
    stats, breakdown: locals.breakdown, panelLabel: 'Cart total'
  }) %>

  <section class="dashboard-section stack">
    <div class="section-head">
      <h2>Recently saved</h2>
      <% if (savedItems.length) { %><a href="/listings">View all saved →</a><% } %>
    </div>

    <% if (!savedItems.length) { %>
      <%- include('partials/empty-state', {
        headline: 'Your cart is empty',
        body: 'Paste a link from OfferUp or Facebook Marketplace and we will pull in the price and photos.',
        actionLabel: 'Save an item',
        actionId: 'openAddModalEmpty'
      }) %>
    <% } else { %>
      <%- include('partials/item-list', {
        items: savedItems,
        categories,
        itemCategoryIndex,
        maxItems: 4,
        allowEdit: true,
        allowDelete: true,
        showCategories: true,
        user: user,
        isOwner: true
      }) %>
    <% } %>
  </section>

  <section class="dashboard-section stack">
    <div class="section-head">
      <h2>Collections</h2>
      <% if (userCollections.length) { %><a href="/categories">View all →</a><% } %>
    </div>

    <% if (!userCollections.length) { %>
      <%- include('partials/empty-state', {
        headline: 'Group what you are hunting for',
        body: 'Collections keep separate hunts apart — apartment, bike build, gifts — each with its own total.',
        actionLabel: 'New collection',
        actionHref: '/categories'
      }) %>
    <% } else { %>
      <div class="category-grid">
        <% userCollections.slice(0, 5).forEach(category => { %>
          <%- include('partials/category-card', {
            category,
            isShared: false,
            showManageButton: false
          }) %>
        <% }) %>

        <a class="collection-card create-card" href="/categories">
          <span class="create-card-plus" aria-hidden="true">+</span>
          <span class="create-card-label">New collection</span>
        </a>
      </div>
    <% } %>
  </section>

  <% if (sharedCategories && sharedCategories.length > 0) { %>
    <section class="dashboard-section stack">
      <div class="section-head">
        <h2>Shared with you</h2>
      </div>

      <div class="category-grid">
        <% sharedCategories.forEach(category => { %>
          <%- include('partials/category-card', {
            category,
            isShared: true,
            showManageButton: false
          }) %>
        <% }) %>
      </div>
    </section>
  <% } %>

</main>

<script src="/js/toast.js"></script>
<script src="/js/stats-panel.js"></script>
<script src="/js/dashboard.js"></script>
<script src="/js/assign-categories.js"></script>
