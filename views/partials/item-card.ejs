<%
  // Which non-default collections hold this item. Precomputed once per request
  // by buildItemCategoryIndex.
  const _memberOf = (typeof itemCategoryIndex !== 'undefined' && itemCategoryIndex)
    ? (itemCategoryIndex[String(item._id)] || [])
    : [];
  const _assignable = (typeof categories !== 'undefined' && categories)
    ? categories.filter(c => !c.isDefault)
    : [];
  // Three states, not two: a real price, a genuine $0 ("Free"), and null —
  // the scraper could not read one. The old `price > 0` gate rendered nothing
  // for the latter two, leaving a blank where the price belongs.
  const _hasPrice = typeof item.price === 'number' && item.price > 0;
  const _isFree = item.price === 0;
  const _host = hostLabel(item.link);
  const _platformKey = String(item.platform || '').toLowerCase();
  const _platformLogo = _platformKey.includes('offerup')
    ? { src: '/images/marketplaces/offerup.svg', alt: 'OfferUp' }
    : _platformKey.includes('facebook')
      ? { src: '/images/marketplaces/facebook.svg', alt: 'Facebook Marketplace' }
      : null;
%>
<li class="card"
    data-title="<%= (item.title || '').toLowerCase() %>"
    data-description="<%= (item.description || '').toLowerCase() %>"
    data-price="<%= item.price || 0 %>"
    data-condition="<%= (item.condition || '').toLowerCase() %>"
    data-platform="<%= (item.platform || '').toLowerCase() %>"
    data-added-at="<%= item.addedAt ? new Date(item.addedAt).getTime() : 0 %>">

  <div class="card__media">
    <% if (item.imageLinks && item.imageLinks[0]) { %>
      <img src="<%= item.imageLinks[0] %>"
           alt="<%= item.title || 'Saved item' %>"
           loading="lazy" decoding="async">
    <% } else { %>
      <div class="card__noimg" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9.5" r="1.5"/>
          <path d="m21 16-5-5L5 20"/>
        </svg>
      </div>
    <% } %>

    <% if (_platformLogo) { %>
      <span class="marketplace-logo marketplace-logo--overlay" title="<%= _platformLogo.alt %>">
        <img class="marketplace-logo__image"
             src="<%= _platformLogo.src %>"
             alt="<%= _platformLogo.alt %>">
      </span>
    <% } else if (item.platform) { %>
      <span class="badge badge--overlay <%= platformClass(item.platform) %>"><%= item.platform %></span>
    <% } %>

    <div class="card__menu kebab-menu">
      <button type="button" class="kebab-btn" aria-label="Actions for <%= item.title || 'this item' %>" aria-haspopup="true" aria-expanded="false">
        <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="10" cy="4" r="2" fill="currentColor"/>
          <circle cx="10" cy="10" r="2" fill="currentColor"/>
          <circle cx="10" cy="16" r="2" fill="currentColor"/>
        </svg>
      </button>
      <div class="kebab-dropdown" role="menu">
        <a class="kebab-action" href="<%= item.link %>" target="_blank" rel="noopener noreferrer" role="menuitem">
          View on <%= _host %> ↗
        </a>
        <button type="button" class="kebab-action" role="menuitem"
                data-copy-link="<%= item.link %>">Copy link</button>

        <% if (allowEdit && categories && _assignable.length) { %>
          <hr class="kebab-divider">
          <div class="category-picker">
            <button type="button" class="picker-toggle" data-item-id="<%= item._id %>" aria-expanded="false">
              <span>Add to collection</span>
              <span class="cat-count"><%= _memberOf.length %></span>
            </button>
            <div class="picker-dropdown">
              <form class="category-checkbox-form" data-item-id="<%= item._id %>">
                <% _assignable.forEach(cat => { %>
                  <label class="checkbox-item">
                    <input type="checkbox" name="categories" value="<%= cat._id %>"
                           <%= _memberOf.includes(String(cat._id)) ? 'checked' : '' %>>
                    <span><%= cat.name %></span>
                  </label>
                <% }) %>
                <button type="submit" class="btn btn--primary btn--sm save-btn">Save</button>
              </form>
            </div>
          </div>
        <% } %>

        <% if (categoryId && user && (isOwner || (addedBy && addedBy._id.toString() === user._id.toString()))) { %>
          <hr class="kebab-divider">
          <form method="POST" action="/categories/<%= categoryId %>/remove-item">
            <input type="hidden" name="itemId" value="<%= item._id %>">
            <button type="submit" class="kebab-action kebab-action--danger" role="menuitem"
                    onclick="return confirm('Remove this item from this collection?')">
              Remove from collection
            </button>
          </form>
        <% } else if (!categoryId && allowDelete && isOwner) { %>
          <hr class="kebab-divider">
          <form method="POST" action="/items/<%= item._id %>?_method=DELETE">
            <button type="submit" class="kebab-action kebab-action--danger" role="menuitem"
                    onclick="return confirm('Remove this saved item?')">
              Delete
            </button>
          </form>
        <% } %>
      </div>
    </div>
  </div>

  <div class="card__body">
    <%
      // One semantic link, stretched over the whole card via ::after. The
      // overflow menu sits above it with z-index so its buttons still work.
    %>
    <h3 class="card__title">
      <a class="card__link" href="<%= item.link %>" target="_blank" rel="noopener noreferrer"><%= item.title || 'Untitled item' %></a>
    </h3>

    <div class="card__row">
      <% if (_hasPrice) { %>
        <span class="card__price"><%= money(item.price) %></span>
      <% } else if (_isFree) { %>
        <span class="card__price card__price--free">Free</span>
      <% } else { %>
        <span class="card__price card__price--unknown">Price unavailable</span>
      <% } %>
    </div>

    <%
      // Empty fields are omitted, never rendered as "N/A".
      const metaBits = [];
      if (item.location) metaBits.push(item.location);
      if (item.condition) metaBits.push(item.condition);
      if (item.addedAt) metaBits.push(relative(item.addedAt));
    %>
    <% if (metaBits.length) { %>
      <p class="card__meta"><%= metaBits.join(' · ') %></p>
    <% } %>

    <% if (showCategories && _memberOf.length) { %>
      <p class="card__tags">
        <% _assignable.forEach(cat => { if (_memberOf.includes(String(cat._id))) { %>
          <span class="category-label"><%= cat.name %></span>
        <% }}) %>
      </p>
    <% } %>

    <% if (showAddedBy && addedBy && addedBy.username) { %>
      <p class="card__by">
        <span class="card__avatar" aria-hidden="true"><%= (addedBy.username || '?').charAt(0).toUpperCase() %></span>
        <%= user && addedBy._id.toString() === user._id.toString() ? 'You' : addedBy.username %>
      </p>
    <% } %>

    <a class="card__out" href="<%= item.link %>" target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 20 20" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M11.5 3.5H16v4.5M16 3.5 9 10.5"/><path d="M14 12v3.5a1 1 0 0 1-1 1H4.5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1H8"/>
      </svg>
      View on <%= _host %>
    </a>
  </div>
</li>
