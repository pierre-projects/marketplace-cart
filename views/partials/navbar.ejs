<nav class="navbar" role="navigation" aria-label="Primary">
  <div class="nav-container">
    <% const _page = typeof currentPage !== 'undefined' ? currentPage : ''; %>
    <a href="/" class="nav-brand brand-logo" aria-label="Marketplace Cart Home">
      <img class="brand-logo__image" src="/images/marketplacecart-transparent.png" alt="">
    </a>

    <% if (typeof user !== 'undefined' && user) { %>
      <%
        // aria-current is emitted with a varying VALUE rather than a varying
        // attribute. The escaping output tag escapes quotes, so building the
        // whole attribute dynamically renders it as visible text, and the raw
        // tag is reserved for includes. "false" is a valid aria-current value
        // meaning "not the current page".
        const _nav = [
          { href: '/dashboard',  key: 'dashboard',  label: 'Dashboard' },
          { href: '/listings',   key: 'listings',   label: 'Saved items' },
          { href: '/collections', key: 'collections', label: 'Collections' },
        ];
      %>
      <ul class="nav-center">
        <% _nav.forEach((n) => { %>
          <li>
            <a href="<%= n.href %>"
               class="nav-link <%= _page === n.key ? 'active' : '' %>"
               aria-current="<%= _page === n.key ? 'page' : 'false' %>"><%= n.label %></a>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <div class="nav-center nav-center--empty" aria-hidden="true"></div>
    <% } %>

    <div class="nav-right">
      <% if (typeof user !== 'undefined' && user) { %>
        <% const username = user.username || 'User'; %>
        <% const avatarInitial = username.charAt(0).toUpperCase(); %>
        <div class="account-menu" data-account-menu>
          <button
            type="button"
            class="account-trigger"
            data-account-trigger
            aria-haspopup="menu"
            aria-expanded="false"
          >
            <span class="account-avatar" aria-hidden="true"><%= avatarInitial %></span>
            <span class="account-name"><%= username %></span>
            <span class="account-chevron" aria-hidden="true">▾</span>
          </button>

          <div class="account-dropdown" data-account-dropdown role="menu" hidden>
            <p class="account-dropdown-label">Signed in as</p>
            <p class="account-dropdown-name"><%= username %></p>

            <div class="theme-toggle" data-theme-toggle role="group" aria-label="Colour theme">
              <button type="button" class="theme-toggle__opt" data-theme-value="system" aria-pressed="false">System</button>
              <button type="button" class="theme-toggle__opt" data-theme-value="light"  aria-pressed="false">Light</button>
              <button type="button" class="theme-toggle__opt" data-theme-value="dark"   aria-pressed="false">Dark</button>
            </div>

            <form method="POST" action="/auth/logout">
              <%- csrfField %>
              <button type="submit" class="account-signout-btn" role="menuitem">Sign out</button>
            </form>
          </div>
        </div>
      <% } else { %>
        <div class="nav-auth">
          <%
            // Signed-out visitors have no account dropdown, so the theme lives
            // here. One button cycling system → light → dark rather than a
            // three-segment control, which ate ~190px of a five-item bar.
            //
            // aria-pressed would be wrong: this is not an on/off toggle. The
            // accessible name carries current state AND next action, and JS
            // rewrites it on every change.
          %>
          <button
            type="button"
            class="theme-cycle"
            data-theme-cycle
            data-theme-choice="system"
            aria-label="Theme: system. Switch to light."
            title="Theme: system"
          >
            <svg class="theme-cycle__icon theme-cycle__icon--system" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="8"/>
              <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor" stroke="none"/>
            </svg>
            <svg class="theme-cycle__icon theme-cycle__icon--light" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4.2"/>
              <path d="M12 2.6v2.2M12 19.2v2.2M4.2 12H2M22 12h-2.2M6.5 6.5 4.9 4.9M19.1 19.1l-1.6-1.6M17.5 6.5l1.6-1.6M4.9 19.1l1.6-1.6"/>
            </svg>
            <svg class="theme-cycle__icon theme-cycle__icon--dark" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 13.4A8.2 8.2 0 0 1 10.6 4a8.4 8.4 0 1 0 9.4 9.4z"/>
            </svg>
          </button>
          <% if (_page !== 'login') { %>
            <a href="/auth/login" class="btn btn--ghost btn--sm">Sign in</a>
          <% } %>
          <% if (_page !== 'register') { %>
            <a href="/auth/register" class="btn btn--primary btn--sm">Sign Up</a>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</nav>
