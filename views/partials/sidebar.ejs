<%
  // Persistent rail for signed-in pages.
  //
  // The header holds NO conditional content. It previously carried a saved-item
  // count that only some routes supplied, so the nav icons shifted vertically
  // depending on which page you were on.
  const _page = typeof currentPage !== 'undefined' ? currentPage : '';
  const _nav = [
    { href: '/dashboard',  key: 'dashboard',  label: 'Dashboard' },
    { href: '/listings',   key: 'listings',   label: 'Saved items' },
    { href: '/collections', key: 'collections', label: 'Collections' },
  ];
  const _username = (user && user.username) ? user.username : 'Account';
%>
<aside class="sidebar">
  <div class="sidebar__head">
    <%- include('brand', { href: '/dashboard', label: 'Marketplace Cart dashboard' }) %>
  </div>

  <nav class="sidebar__nav" aria-label="Primary">
    <ul>
      <% _nav.forEach((n) => { %>
        <li>
          <a href="<%= n.href %>"
             class="sidebar__link <%= _page === n.key ? 'is-active' : '' %>"
             aria-current="<%= _page === n.key ? 'page' : 'false' %>">
            <span class="sidebar__icon" aria-hidden="true">
              <% if (n.key === 'dashboard') { %>
                <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6">
                  <rect x="2.5" y="2.5" width="6" height="6" rx="1.4"/><rect x="11.5" y="2.5" width="6" height="6" rx="1.4"/>
                  <rect x="2.5" y="11.5" width="6" height="6" rx="1.4"/><rect x="11.5" y="11.5" width="6" height="6" rx="1.4"/>
                </svg>
              <% } else if (n.key === 'listings') { %>
                <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6">
                  <path d="M5 2.8h10a1 1 0 0 1 1 1v13.4l-6-3.4-6 3.4V3.8a1 1 0 0 1 1-1Z"/>
                </svg>
              <% } else { %>
                <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6">
                  <path d="M2.6 5.4a1 1 0 0 1 1-1h3.3l1.6 2h7a1 1 0 0 1 1 1v7.2a1 1 0 0 1-1 1H3.6a1 1 0 0 1-1-1Z"/>
                </svg>
              <% } %>
            </span>
            <span><%= n.label %></span>
          </a>
        </li>
      <% }) %>
    </ul>
  </nav>

  <div class="sidebar__foot">
    <a class="sidebar__account" href="/settings"
       aria-current="<%= _page === 'settings' ? 'page' : 'false' %>">
      <span class="account-avatar" aria-hidden="true"><%= _username.charAt(0).toUpperCase() %></span>
      <span class="account-name"><%= _username %></span>
      <span class="sidebar__gear" aria-hidden="true">
        <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6">
          <circle cx="10" cy="10" r="2.6"/>
          <path d="M10 2.6v1.6M10 15.8v1.6M17.4 10h-1.6M4.2 10H2.6M15.2 4.8l-1.1 1.1M5.9 14.1l-1.1 1.1M15.2 15.2l-1.1-1.1M5.9 5.9 4.8 4.8"/>
        </svg>
      </span>
      <span class="sr-only">Settings</span>
    </a>
  </div>
</aside>

<%
  // Mobile navigation. Rendered alongside the rail; only one is visible at a
  // time, decided entirely in CSS.
%>
<nav class="tabbar" aria-label="Primary">
  <ul>
    <% _nav.forEach((n) => { %>
      <li>
        <a href="<%= n.href %>"
           class="tabbar__link <%= _page === n.key ? 'is-active' : '' %>"
           aria-current="<%= _page === n.key ? 'page' : 'false' %>">
          <span class="tabbar__icon" aria-hidden="true">
            <% if (n.key === 'dashboard') { %>
              <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6">
                <rect x="2.5" y="2.5" width="6" height="6" rx="1.4"/><rect x="11.5" y="2.5" width="6" height="6" rx="1.4"/>
                <rect x="2.5" y="11.5" width="6" height="6" rx="1.4"/><rect x="11.5" y="11.5" width="6" height="6" rx="1.4"/>
              </svg>
            <% } else if (n.key === 'listings') { %>
              <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M5 2.8h10a1 1 0 0 1 1 1v13.4l-6-3.4-6 3.4V3.8a1 1 0 0 1 1-1Z"/>
              </svg>
            <% } else { %>
              <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M2.6 5.4a1 1 0 0 1 1-1h3.3l1.6 2h7a1 1 0 0 1 1 1v7.2a1 1 0 0 1-1 1H3.6a1 1 0 0 1-1-1Z"/>
              </svg>
            <% } %>
          </span>
          <span class="tabbar__label"><%= n.label %></span>
        </a>
      </li>
    <% }) %>
  </ul>
</nav>
