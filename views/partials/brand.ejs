<%
  // The brand lockup: a vector mark plus a live-text wordmark. It replaces the
  // raster logo, which blurred at every size and could not follow the theme
  // or the accent preset.
  const _href = typeof href === 'string' ? href : '/';
  const _label = typeof label === 'string' ? label : 'Marketplace Cart home';
  const _extra = typeof className === 'string' ? ` ${className}` : '';
%>
<a class="brand<%= _extra %>" href="<%= _href %>" aria-label="<%= _label %>">
  <span class="brand__mark" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 4h2.2l2.1 10.2a1.6 1.6 0 0 0 1.6 1.3h8.3a1.6 1.6 0 0 0 1.6-1.2L20.5 8H6.4"/>
      <circle cx="9.5" cy="19.5" r="1.3" fill="currentColor" stroke="none"/>
      <circle cx="17" cy="19.5" r="1.3" fill="currentColor" stroke="none"/>
    </svg>
  </span>
  <span class="brand__name">Marketplace <span>Cart</span></span>
</a>
