<%
  const isShared = locals.isShared === true;
  const showManageButton = locals.showManageButton === true;

  // Counts and value come from the route (buildCardStats), which uses the same
  // helpers as the collection page — a card cannot disagree with the page it
  // links to. The fallback keeps the partial renderable on its own.
  const _card = (locals.cardStats && locals.cardStats[String(category._id)]) || null;
  const _stats = _card ? _card.stats : { totalItems: 0, totalValue: 0, availableCount: 0 };
  const _platforms = _card && _card.breakdown ? _card.breakdown.platforms : [];

  const categoryItems = Array.isArray(category.items) ? category.items : [];
  const previewItems = categoryItems
    .filter((entry) => entry && entry.item && entry.item.imageLinks && entry.item.imageLinks.length > 0)
    .slice(0, 3);

  // Slots share the row evenly however many there are, so one image spans the
  // full width. The old markup padded to three with diagonal-striped blanks,
  // which read as a rendering fault rather than an absence.
  const _slots = previewItems.length;
%>

<article class="collection-card<%= isShared ? ' collection-card--shared' : '' %>">
  <a class="collection-card__link" href="/categories/<%= category._id %>">
    <span class="sr-only">Open <%= category.name %></span>
  </a>

  <div class="collection-card__media" data-slots="<%= _slots %>" aria-hidden="true">
    <% if (_slots === 0) { %>
      <div class="collection-card__empty">No items yet</div>
    <% } else { %>
      <% previewItems.forEach((entry) => { %>
        <div class="collection-card__slot">
          <img src="<%= entry.item.imageLinks[0] %>"
               alt=""
               loading="lazy"
               decoding="async">
        </div>
      <% }) %>
    <% } %>
  </div>

  <div class="collection-card__body">
    <div class="collection-card__head">
      <h3 class="collection-card__name"><%= category.name %></h3>
      <% if (isShared) { %>
        <span class="badge badge--neutral">Shared</span>
      <% } %>
    </div>

    <p class="collection-card__value"><%= money(_stats.totalValue) %></p>

    <p class="collection-card__meta">
      <%= plural(_stats.totalItems, 'item') %>
      <% if (_stats.totalItems > 0) { %>
        · <%= _stats.availableCount %> still live
      <% } %>
    </p>

    <% if (_platforms.length) { %>
      <div class="collection-card__platforms">
        <% _platforms.forEach((row) => { %>
          <span class="badge <%= platformClass(row.platform) %>"><%= row.platform %></span>
        <% }) %>
      </div>
    <% } %>
  </div>

  <%
    // Icon rather than a "Manage" text button: the card is one big link, and a
    // second worded control beside it competed for the same click.
    // z-index lifts it above the stretched link.
  %>
  <% if (showManageButton) { %>
    <button type="button"
            class="collection-card__manage manage-btn"
            data-id="<%= category._id %>"
            data-name="<%= category.name %>"
            aria-label="Manage <%= category.name %>">
      <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true">
        <circle cx="10" cy="4" r="2" fill="currentColor"/>
        <circle cx="10" cy="10" r="2" fill="currentColor"/>
        <circle cx="10" cy="16" r="2" fill="currentColor"/>
      </svg>
    </button>
  <% } %>
</article>
