<%
  // Logged-out pages only — signed-in pages live inside the app shell, where a
  // marketing footer under every list of items would just be noise.
  const signedIn = typeof user !== 'undefined' && user;
%>
<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">Marketplace Cart</div>

    <p class="site-footer__tagline">Save listings from OfferUp and Facebook Marketplace in one place.</p>

    <nav class="site-footer__links" aria-label="Footer">
      <% if (signedIn) { %>
        <a href="/dashboard">Dashboard</a>
        <a href="/listings">Saved items</a>
      <% } else { %>
        <a href="/auth/login">Login</a>
        <a href="/auth/register">Sign up</a>
      <% } %>
    </nav>
  </div>
</footer>
