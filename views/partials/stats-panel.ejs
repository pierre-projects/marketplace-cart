<%
  const _label = typeof panelLabel !== 'undefined' ? panelLabel : 'Total value';
  const _bd = typeof breakdown !== 'undefined' && breakdown ? breakdown : null;
  const _rows = _bd && Array.isArray(_bd.platforms) ? _bd.platforms : [];
  const _stats = typeof stats !== 'undefined' && stats ? stats : {};
  const _totalItems = Number(_stats.totalItems) || 0;

  const _summaryBits = [plural(_totalItems, 'item')];
  if ((_stats.freeCount || 0)) _summaryBits.push(plural(_stats.freeCount, 'free item'));
  if ((_stats.unpricedCount || 0)) _summaryBits.push(plural(_stats.unpricedCount, 'item') + ' with no price');

  const _pricedTotal = _rows.reduce((sum, row) => sum + (Number(row.subtotal) || 0), 0);
  const _itemBasisTotal = _rows.reduce((sum, row) => sum + (Array.isArray(row.items) ? row.items.length : 0), 0);
  const _usesValue = _pricedTotal > 0;
  const _basisTotal = _usesValue ? _pricedTotal : _itemBasisTotal;
  let _usedPercent = 0;

  const _platformMeta = (platform) => {
    const key = String(platform || '').toLowerCase();
    if (key.includes('offerup')) {
      return { kind: 'offerup', logo: '/images/marketplaces/offerup.svg', alt: 'OfferUp' };
    }
    if (key.includes('facebook')) {
      return { kind: 'facebook', logo: '/images/marketplaces/facebook.svg', alt: 'Facebook Marketplace' };
    }
    return { kind: 'neutral', logo: null, alt: String(platform || 'Unknown marketplace') };
  };

  // Known marketplaces keep their brand hue; the rest take the categorical
  // chart ramp in order, so two "other" sites never share a colour.
  let _nextChart = 0;
  const _colorFor = (kind) => {
    if (kind === 'offerup') return 'var(--mkt-offerup)';
    if (kind === 'facebook') return 'var(--mkt-facebook)';
    _nextChart += 1;
    return `var(--chart-${((_nextChart - 1) % 8) + 1})`;
  };

  const _segments = _rows.map((row, index) => {
    const items = Array.isArray(row.items) ? row.items : [];
    const basis = _usesValue ? (Number(row.subtotal) || 0) : items.length;
    const rawPercent = _basisTotal > 0 ? (basis / _basisTotal) * 100 : 0;
    const remaining = Math.max(0, Number((100 - _usedPercent).toFixed(1)));
    const percent = index === _rows.length - 1
      ? remaining
      : Math.min(remaining, Number(rawPercent.toFixed(1)));
    const offset = _usedPercent;
    _usedPercent = Number((_usedPercent + percent).toFixed(1));

    const meta = _platformMeta(row.platform);
    return {
      row,
      items,
      percent,
      offset,
      meta,
      color: _colorFor(meta.kind)
    };
  });

  const _defaultCenterValue = String(_rows.length);
  const _defaultCenterLabel = _rows.length === 1 ? 'marketplace' : 'marketplaces';
%>

<section class="stats-panel<%= _rows.length ? '' : ' stats-panel--summary-only' %>"
         aria-labelledby="stats-panel-label"
         data-stats-panel
         data-default-value="<%= _defaultCenterValue %>"
         data-default-label="<%= _defaultCenterLabel %>">
  <div class="stats-panel__layout">
    <div class="stats-panel__summary">
      <h2 class="stats-panel__label" id="stats-panel-label"><%= _label %></h2>
      <p class="stats-panel__figure"><%= money((_stats.totalValue || 0)) %></p>
      <p class="stats-panel__meta"><%= _summaryBits.join(' · ') %></p>
    </div>

    <% if (_segments.length) { %>
      <div class="stats-panel__breakdown" aria-labelledby="stats-panel-distribution-label">
        <div class="stats-panel__breakdown-head">
          <h3 class="stats-panel__distribution-title" id="stats-panel-distribution-label">
            <%= _usesValue ? 'Value by marketplace' : 'Items by marketplace' %>
          </h3>
          <p class="stats-panel__distribution-sub">
            <%= _usesValue ? 'Share of priced total' : 'All saved items are free or unpriced' %>
          </p>
        </div>

        <div class="stats-panel__breakdown-body">
          <div class="stats-panel__donut" aria-hidden="true">
            <svg viewBox="0 0 42 42" focusable="false">
              <circle class="stats-panel__donut-track" cx="21" cy="21" r="15.9155" pathLength="100"></circle>
              <% _segments.forEach((segment, index) => { %>
                <circle class="stats-panel__donut-segment stats-panel__donut-segment--<%= segment.meta.kind %>"
                        cx="21" cy="21" r="15.9155" pathLength="100"
                        stroke-dasharray="<%= segment.percent %> <%= Math.max(0, 100 - segment.percent) %>"
                        stroke-dashoffset="<%= -segment.offset %>"
                        style="--segment-delay: <%= index * 70 %>ms; --seg: <%= segment.color %>"
                        data-chart-segment="<%= index %>"></circle>
              <% }) %>
            </svg>
            <span class="stats-panel__donut-center">
              <strong data-chart-center-value><%= _defaultCenterValue %></strong>
              <span data-chart-center-label><%= _defaultCenterLabel %></span>
            </span>
          </div>

          <ul class="stats-panel__legend" aria-label="Marketplace breakdown">
            <% _segments.forEach((segment, index) => { %>
              <li style="--seg: <%= segment.color %>">
                <button type="button"
                        class="stats-panel__legend-button stats-panel__legend-button--<%= segment.meta.kind %>"
                        data-chart-control="<%= index %>"
                        data-chart-percent="<%= segment.percent %>%"
                        data-chart-platform="<%= segment.meta.alt %>"
                        aria-pressed="false"
                        aria-label="<%= segment.meta.alt %>: <%= segment.percent %> percent, <%= plural(segment.items.length, 'item') %>, <%= money(segment.row.subtotal) %>">
                  <span class="stats-panel__marketplace-mark" aria-hidden="true">
                    <% if (segment.meta.logo) { %>
                      <img src="<%= segment.meta.logo %>" alt="">
                    <% } else { %>
                      <span><%= segment.meta.alt.charAt(0).toUpperCase() %></span>
                    <% } %>
                  </span>
                  <span class="stats-panel__legend-copy">
                    <span class="stats-panel__legend-name" title="<%= segment.meta.alt %>"><%= segment.meta.alt %></span>
                    <span class="stats-panel__legend-count"><%= plural(segment.items.length, 'item') %></span>
                  </span>
                  <span class="stats-panel__legend-percent tnum"><%= segment.percent %>%</span>
                  <span class="stats-panel__amount tnum"><%= money(segment.row.subtotal) %></span>
                </button>
              </li>
            <% }) %>
          </ul>
        </div>
      </div>
    <% } %>
  </div>
</section>
