<%
  const collectionCreateReturnTo = typeof returnTo === 'string' && returnTo.trim()
    ? returnTo
    : '/categories';
  const collectionCreateInputId = typeof inputId === 'string' && inputId.trim()
    ? inputId
    : 'newCollectionName';
  const collectionCreateOpen = typeof open === 'boolean' ? open : false;
  const collectionCreateLabel = typeof label === 'string' && label.trim()
    ? label
    : 'New collection';
  const collectionCreateDescription = typeof description === 'string'
    ? description.trim()
    : '';
  const collectionCreateDescriptionId = `${collectionCreateInputId}Description`;
%>

<details class="collection-create<%= collectionCreateDescription ? ' collection-create--onboarding' : '' %>"
         data-collection-create<% if (collectionCreateOpen) { %> open<% } %>>
  <summary class="collection-create__summary">
    <span class="collection-create__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7">
        <path d="M3.5 6.5h6l2 2h9v9.5a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z"/>
        <path d="M12 11.5v5M9.5 14h5"/>
      </svg>
    </span>
    <strong><%= collectionCreateLabel %></strong>
    <svg class="collection-create__chevron" viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="m6 8 4 4 4-4"/>
    </svg>
  </summary>

  <% if (collectionCreateDescription) { %>
    <div class="collection-create__intro">
      <p id="<%= collectionCreateDescriptionId %>"><%= collectionCreateDescription %></p>
    </div>
  <% } %>

  <form class="collection-create__form" action="/categories/create" method="POST">
    <input type="hidden" name="returnTo" value="<%= collectionCreateReturnTo %>">
    <label for="<%= collectionCreateInputId %>">Collection name</label>
    <input type="text" id="<%= collectionCreateInputId %>" name="name"<% if (collectionCreateDescription) { %>
           aria-describedby="<%= collectionCreateDescriptionId %>"<% } %>
           placeholder="e.g. Living room" required maxlength="60" autocomplete="off">
    <button type="submit" class="btn btn--primary">Create</button>
  </form>
</details>
