<% const showAddedBy = typeof locals.showAddedBy !== 'undefined' ? locals.showAddedBy : false; %>
<% const _maxItems = typeof maxItems !== 'undefined' ? maxItems : null; %>

<%
  // Renders exactly the order it is given — callers sort with
  // sortEntriesByNewest before passing items in. This used to .reverse(), a
  // positional stand-in for "newest first" that assumed push order matched
  // date order; once the routes started sorting, the two cancelled and the
  // grid came out oldest-first. maxItems takes from the FRONT for the same
  // reason: slice(-n) meant "most recently pushed", not "newest".
%>
<% const displayItems = _maxItems ? items.slice(0, _maxItems) : items; %>
<% const thisCategoryId = typeof categoryId !== 'undefined' ? categoryId : null; %>
<% const _itemCategoryIndex = typeof itemCategoryIndex !== 'undefined' ? itemCategoryIndex : {}; %>

<ul class="item-list grid-cards">
  <% displayItems.forEach(entry => { %>
    <%
      // Shape is detected per entry, not inferred once from items[0]. Callers
      // pass either bare Item docs or {item, addedBy} wrappers, and a wrapper
      // whose item populated to null must still be recognized as a wrapper —
      // hence `!== undefined` rather than a truthiness check.
      const isWrapper = entry && entry.item !== undefined;
      const item = isWrapper ? entry.item : entry;
      const addedBy = isWrapper ? entry.addedBy : null;
    %>
    <% if (item && item._id) { %>
      <%- include('./item-card', {
          item,
          addedBy,
          categories,
          itemCategoryIndex: _itemCategoryIndex,
          allowEdit,
          allowDelete,
          showCategories,
          categoryId: thisCategoryId,
          user,
          isOwner,
          showAddedBy
        }) %>
    <% } %>
  <% }) %>
</ul>
