<main class="container" id="main">
  <%- include('../partials/flash-alert') %>

  <%
    const items = listings.map(e => (e && e.item !== undefined ? e.item : e)).filter(Boolean);
    const total = items.reduce((sum, i) => sum + (typeof i.price === 'number' ? i.price : 0), 0);
    const conditions = [...new Set(items.map(i => i.condition).filter(Boolean))];
    const platforms = [...new Set(items.map(i => i.platform).filter(Boolean))];
  %>

  <div class="page-head">
    <div>
      <h1>Saved items</h1>
      <p class="page-head__sub"><%= plural(items.length, 'item') %> · <%= money(total) %> total</p>
    </div>
    <button id="openAddModal" type="button" class="btn btn--primary">Save an item</button>
  </div>

  <%- include('../partials/add-listing-modal', { categories, returnTo: '/listings', defaultCategoryId: null }) %>

  <% if (items.length === 0) { %>
    <%- include('../partials/empty-state', {
      headline: 'Your cart is empty',
      body: 'Paste a link from OfferUp or Facebook Marketplace and we will pull in the price and photos.',
      actionLabel: 'Save an item',
      actionId: 'openAddModalEmpty'
    }) %>
  <% } else { %>

    <div class="toolbar" data-toolbar>
      <div class="toolbar__search">
        <span class="toolbar__search-icon" aria-hidden="true">
          <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="9" cy="9" r="5.2"/><path d="m13 13 4 4"/>
          </svg>
        </span>
        <label class="sr-only" for="searchInput">Search saved items</label>
        <input type="search" id="searchInput" placeholder="Search saved items" autocomplete="off">
        <button type="button" class="toolbar__clear" id="searchClear" aria-label="Clear search" hidden>&times;</button>
      </div>

      <div class="toolbar__filters">
        <button type="button" class="btn btn--secondary" id="filtersToggle" aria-expanded="false" aria-controls="filtersPanel">
          <svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M3 5.5h14M6 10h8M8.5 14.5h3"/>
          </svg>
          Filters
          <span class="count-badge" id="filtersCount" hidden>0</span>
        </button>

        <div class="filters-panel" id="filtersPanel" hidden>
          <% if (conditions.length) { %>
            <fieldset class="filters-panel__group">
              <legend>Condition</legend>
              <% conditions.forEach(c => { %>
                <label class="checkbox-item">
                  <input type="checkbox" data-filter-condition value="<%= c.toLowerCase() %>">
                  <span><%= c %></span>
                </label>
              <% }) %>
            </fieldset>
          <% } %>
          <% if (platforms.length > 1) { %>
            <fieldset class="filters-panel__group">
              <legend>Marketplace</legend>
              <% platforms.forEach(p => { %>
                <label class="checkbox-item">
                  <input type="checkbox" data-filter-platform value="<%= p.toLowerCase() %>">
                  <span><%= p %></span>
                </label>
              <% }) %>
            </fieldset>
          <% } %>
          <button type="button" class="btn btn--ghost btn--sm" id="filtersClear">Clear filters</button>
        </div>
      </div>

      <div class="toolbar__sort">
        <label class="sr-only" for="sortSelect">Sort</label>
        <select id="sortSelect">
          <option value="newest">Sort: Date saved</option>
          <option value="oldest">Sort: Oldest first</option>
          <option value="price-high">Sort: Price high to low</option>
          <option value="price-low">Sort: Price low to high</option>
          <option value="title">Sort: Title A–Z</option>
          <option value="condition">Sort: Condition</option>
        </select>
      </div>

    </div>

    <div class="active-filters" id="activeFilters" hidden>
      <div class="active-filters__pills" id="activeFilterPills"></div>
      <button type="button" class="link-button" id="clearAllFilters">Clear all</button>
    </div>

    <p class="sr-only" id="resultCount" aria-live="polite" role="status"></p>

    <div id="noResults" class="is-hidden">
      <%- include('../partials/empty-state', {
        headline: 'Nothing matches your filters',
        body: 'Try a shorter search, or clear your filters.',
        actionLabel: 'Clear filters',
        actionId: 'clearFiltersEmpty'
      }) %>
    </div>

    <%- include('../partials/item-list', {
      items: listings,
      categories,
      allowEdit: true,
      allowDelete: true,
      showCategories: true,
      user: user,
      isOwner: true
    }) %>

  <% } %>
</main>

<script src="/js/toast.js"></script>
<script src="/js/listings.js"></script>
<script src="/js/dashboard.js"></script>
<script src="/js/assign-categories.js"></script>
