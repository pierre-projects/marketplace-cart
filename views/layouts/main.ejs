<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' && title ? title : 'Marketplace Cart' %></title>
  <meta name="color-scheme" content="light dark">
  <link rel="icon" type="image/png" href="/favicon.png">
  <%# Read by public/js/lib/api.js for the X-CSRF-Token header. %>
  <meta name="csrf-token" content="<%= csrfToken %>">

  <%
    // Runs before any stylesheet so the correct theme is stamped on <html>
    // during parse — otherwise a dark-mode user sees a white flash on every
    // navigation. Deliberately inline and blocking; it is a few hundred bytes.
    //
    // This RESOLVES "system" rather than leaving the attribute off, so
    // tokens.css needs only the [data-theme='dark'] selector and not a
    // duplicated prefers-color-scheme copy of the whole palette. The cost is
    // that with JS disabled everyone gets the light palette, which is the
    // light-first default the design system is built around anyway.
  %>
  <script nonce="<%= cspNonce %>">
    (function () {
      try {
        var r = document.documentElement;
        var t = localStorage.getItem('theme');
        if (t !== 'light' && t !== 'dark') {
          // No explicit choice: follow the OS, but remember that we are only
          // following it, so the toggle can still show "System" as selected.
          t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          r.dataset.themeSource = 'system';
        }
        r.dataset.theme = t;
        // The accent must be stamped here too, or the previous accent paints
        // for a frame on every navigation.
        var a = localStorage.getItem('accent');
        if (a && a !== 'default') r.dataset.accent = a;
      } catch (e) {}
    })();
  </script>

  <!-- Order matters: tokens define the variables everything else consumes. -->
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/pages.css">
  <%- style %>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <%
    // Signed-in pages get the persistent rail; logged-out pages (landing, auth,
    // error) keep the top bar, where a nav rail would be meaningless.
    const signedIn = typeof user !== 'undefined' && user;
  %>
  <% if (signedIn) { %>
    <div class="app-shell">
      <%- include('../partials/sidebar') %>
      <div class="app-shell__content">
        <%- body %>
      </div>
    </div>
  <% } else { %>
    <%
      // Flex column so a full-height page can be `flex: 1` instead of
      // subtracting a hardcoded navbar height from 100dvh — that number was
      // wrong by 1px on desktop and 6px on mobile, and every change to the bar
      // silently broke it again.
    %>
    <div class="page-shell">
      <%- include('../partials/navbar') %>
      <%- body %>
    </div>
  <% } %>

  <!-- Single live region for client-side feedback. -->
  <div id="toasts" class="toasts" aria-live="polite" aria-atomic="false"></div>

  <script type="module" src="/js/app.js"></script>
  <%- script %>
</body>
</html>
