# Copy to .env and fill in. config/env.js validates these at startup.

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/marketplacecart
# At least 32 random characters in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_something_random

# development | production. Production turns on secure cookies.
NODE_ENV=development

# Set to 1 behind a reverse proxy (Render, Fly, nginx) so secure cookies work.
# TRUST_PROXY=1

# Chrome for the Facebook scraper, if Puppeteer cannot find one.
# PUPPETEER_EXECUTABLE_PATH=
